# Environment variables (contains sensitive data)
.env
.env.local
.env.*.local

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Session storage
app/sessions/

# User-created quizzes (ignore JSON files but keep folder structure)
app/quizzes/*.json
app/quizzes/completed/*.json

# Uploaded media files (question images)
app/public/uploads/

# Archive folders
app/archive/
screenshots/archive/
archive/Session Logs/

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
.temp/

# Development/Internal documentation (for AI agents and internal use only)
DEV-SUMMARY.md
PHASE-*.md
*-PLAN.md
CLAUDE.md
AGENTS.md

# LOCAL-AI folder - AI assistant onboarding, memory, and internal docs (DO NOT COMMIT)
LOCAL-AI/

# Continue.dev configuration and rules (local AI assistant config)
.continue/
.omc/
.claude/

# Vite build output
app/dist/
.gitnexus

# Git worktrees
.worktrees/

# Graphify knowledge graph outputs
graphify-out/
.graphify_python

# Local MCP server config
.mcp.json

# Terraform state and cache (state contains generated secrets in plaintext -- see
# deploy/aws/README.md). .terraform.lock.hcl is NOT ignored -- Terraform's own convention is to
# commit it, so `terraform init` always picks the same provider versions.
deploy/aws/terraform/.terraform/
deploy/aws/terraform/*.tfstate
deploy/aws/terraform/*.tfstate.*
deploy/aws/terraform/*.tfplan
deploy/aws/terraform/tfplan
deploy/aws/terraform/terraform.tfvars
